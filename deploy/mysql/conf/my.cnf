[mysqld]
server-id = 1
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default-time-zone = '+08:00'

# 二进制日志（主从复制、GTID、备份恢复）
log-bin = mysql-bin
binlog_format = ROW
gtid_mode = ON
enforce_gtid_consistency = ON
expire_logs_days = 7

# 性能优化
innodb_buffer_pool_size = 4G
innodb_flush_log_at_trx_commit = 2
max_connections = 500

# 慢查询日志
slow_query_log = 1
long_query_time = 2
