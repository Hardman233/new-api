# 端口号
# PORT=3000
# 前端基础URL
# FRONTEND_BASE_URL=https://your-frontend-url.com


# 调试相关配置
# 启用pprof
# ENABLE_PPROF=true
# 启用调试模式
# DEBUG=true
# Pyroscope 配置
# PYROSCOPE_URL=http://localhost:4040
# PYROSCOPE_APP_NAME=new-api
# PYROSCOPE_BASIC_AUTH_USER=your-user
# PYROSCOPE_BASIC_AUTH_PASSWORD=your-password
# PYROSCOPE_MUTEX_RATE=5
# PYROSCOPE_BLOCK_RATE=5
# HOSTNAME=your-hostname

# 数据库相关配置
# 启用错误日志记录
# ERROR_LOG_ENABLED=true
# 数据库连接字符串
# SQL_DSN=user:password@tcp(127.0.0.1:3306)/dbname?parseTime=true
# 日志数据库连接字符串
# LOG_SQL_DSN=user:password@tcp(127.0.0.1:3306)/logdb?parseTime=true
# SQLite数据库路径
# SQLITE_PATH=/path/to/sqlite.db
# 数据库最大空闲连接数
# SQL_MAX_IDLE_CONNS=100
# 数据库最大打开连接数
# SQL_MAX_OPEN_CONNS=1000
# 数据库连接最大生命周期（秒）
# SQL_MAX_LIFETIME=60


# 缓存相关配置
# Redis连接字符串
# REDIS_CONN_STRING=redis://user:password@localhost:6379/0
# 同步频率（单位：秒）
# SYNC_FREQUENCY=60
# 内存缓存启用
# MEMORY_CACHE_ENABLED=true
# 渠道更新频率（单位：秒）
# CHANNEL_UPDATE_FREQUENCY=30
# 批量更新启用
# BATCH_UPDATE_ENABLED=true
# 批量更新间隔（单位：秒）
# BATCH_UPDATE_INTERVAL=5

# 任务和功能配置
# 更新任务启用
# UPDATE_TASK=true

# 对话超时设置
# 所有请求超时时间，单位秒，默认为0，表示不限制
# RELAY_TIMEOUT=0
# 流模式无响应超时时间，单位秒，如果出现空补全可以尝试改为更大值
# STREAMING_TIMEOUT=300

# TLS / HTTP 跳过验证设置
# TLS_INSECURE_SKIP_VERIFY=false

# Gemini 识别图片 最大图片数量
# GEMINI_VISION_MAX_IMAGE_NUM=16

# 会话密钥
# SESSION_SECRET=random_string

# ============================================================
# 二开：请求/响应审计留存 + 消费金额写入 + 媒体 OSS
# 复制本文件为 .env 并填好下列值；.env 已在 .gitignore，不会提交
# ============================================================

# —— 审计总开关 ——
AUDIT_LOG_ENABLED=true
# 正文加密密钥（必填且保密）：openssl rand -base64 32
AUDIT_LOG_SECRET=
# 留存天数，默认 7
AUDIT_LOG_RETENTION_DAYS=7
# 是否记录客户端 IP，默认 false
AUDIT_LOG_RECORD_IP=false

# --- Billing ledger region/currency ---
# Domestic server:
# SERVER_REGION=domestic
# SERVER_BILLING_CURRENCY=CNY
# Overseas server:
# SERVER_REGION=overseas
# SERVER_BILLING_CURRENCY=USD
# Leave LOG_SQL_DSN empty in v1 so logs/audit/ledger share SQL_DSN.

# --- Internal cluster auth and billing sync ---
# Domestic server: set INTERNAL_API_KEY to receive remote auth verify and billing import.
# Overseas server: use the same value in REMOTE_AUTH_API_KEY and BILLING_SYNC_API_KEY.
# INTERNAL_API_KEY=
#
# Overseas login via domestic identity. This does not share overseas channels/tokens/prices/balances.
# REMOTE_AUTH_ENABLED=false
# REMOTE_AUTH_BASE_URL=https://ai.ocstudio.cc
# REMOTE_AUTH_API_KEY=
# REMOTE_AUTH_TIMEOUT_SEC=5
# REMOTE_AUTH_SYNC_ROLE=false
# REMOTE_AUTH_SYNC_GROUP=false
# REMOTE_AUTH_DEFAULT_GROUP=default
# REMOTE_AUTH_INITIAL_QUOTA=0
#
# Overseas -> domestic reporting sync. Only final billing_ledger rows are imported.
# BILLING_SYNC_ENABLED=false
# BILLING_SYNC_TARGET_URL=https://ai.ocstudio.cc
# BILLING_SYNC_API_KEY=
# BILLING_SYNC_INTERVAL_SEC=60
# BILLING_SYNC_BATCH_SIZE=100
# BILLING_SYNC_HTTP_TIMEOUT_SEC=10
# BILLING_SYNC_RETRY_BASE_SEC=60
# SERVER_NODE_NAME=

# --- Daily billing backup ---
# Generates daily files under /data/billing-backups by default:
#   summary-YYYY-MM-DD.json
#   billing-ledger-YYYY-MM-DD.jsonl.gz
#   consume-logs-YYYY-MM-DD.jsonl.gz
# Details include model/channel/user/token usage, amount, quota, prompt/completion/cache tokens, and usage_source.
# DAILY_BILLING_BACKUP_ENABLED=true
# DAILY_BILLING_BACKUP_DIR=/data/billing-backups
# DAILY_BILLING_BACKUP_RUN_AT=00:15
# DAILY_BILLING_BACKUP_LOOKBACK_DAYS=1
# DAILY_BILLING_BACKUP_RUN_ON_STARTUP=false
# 0 means keep backup files forever.
# DAILY_BILLING_BACKUP_RETENTION_DAYS=0

# —— 媒体二进制存储（外部云 OSS / S3 兼容）——
# 纯文本对话直接进数据库，不需要 OSS；
# 留空 AUDIT_OSS_BUCKET 则不启用 OSS，媒体二进制只记元信息（size+sha256）
AUDIT_OSS_BUCKET=
# S3 端点：
#   火山引擎 TOS  https://tos-s3-cn-beijing.volces.com   (region=cn-beijing)
#   阿里云 OSS    https://oss-cn-hangzhou.aliyuncs.com
#   腾讯云 COS    https://cos.ap-guangzhou.myqcloud.com
#   AWS S3        留空（走 region）
#   自建 MinIO    http://minio:9000
AUDIT_OSS_ENDPOINT=
AUDIT_OSS_REGION=cn-hangzhou
AUDIT_OSS_ACCESS_KEY=
AUDIT_OSS_SECRET_KEY=
AUDIT_OSS_KEY_PREFIX=audit
# 阿里云/腾讯/AWS 用 false；自建 MinIO 用 true
AUDIT_OSS_FORCE_PATH_STYLE=false

# 其他配置
# 生成默认token
# GENERATE_DEFAULT_TOKEN=false
# Cohere 安全设置
# COHERE_SAFETY_SETTING=NONE
# 是否统计图片token
# GET_MEDIA_TOKEN=true
# 是否在非流（stream=false）情况下统计图片token
# GET_MEDIA_TOKEN_NOT_STREAM=false
# 设置 Dify 渠道是否输出工作流和节点信息到客户端
# DIFY_DEBUG=true

# LinuxDo相关配置
LINUX_DO_TOKEN_ENDPOINT=https://connect.linux.do/oauth2/token
LINUX_DO_USER_ENDPOINT=https://connect.linux.do/api/user

# 节点类型
# 如果是主节点则为master
# NODE_TYPE=master

# 可信任重定向域名列表（逗号分隔，支持子域名匹配）
# 用于验证支付成功/取消回调URL的域名安全性
# 示例: example.com,myapp.io 将允许 example.com, sub.example.com, myapp.io 等
# TRUSTED_REDIRECT_DOMAINS=example.com,myapp.io
